POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app_db
# Своя роль db-svc (DBSVC_DB_USER/DBSVC_DB_PASSWORD в корневом .env), а не суперпользователь:
# права описаны в main/infra/db/init/roles/grants.sql. В compose эти значения перекрываются.
POSTGRES_USER=dbsvc_user
POSTGRES_PASSWORD=dbsvc_password

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_REGION=us-east-1
MINIO_SECURE=false
# Хост для presigned URL — должен быть доступен из БРАУЗЕРА, а не из контейнера
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false

DBSVC_ADMIN_TOKEN=123456

# Курирование графа: db-svc проксирует запросы в graph-rag-svc (/internal/graph/*),
# а не правит таблицы graph.* напрямую. Токен должен совпадать с TRUSTED_SERVICE_TOKENS
# у graph-rag-svc.
GRAPH_RAG_URL=http://graph-rag-svc:8000
SERVICE_NAME=db-svc
SERVICE_TOKEN=CHANGE_ME
INTERNAL_AUTH_HEADER_NAME=X-Service-Token
INTERNAL_SERVICE_NAME_HEADER=X-Service-Name

# Доверять заголовку X-User-Role от nginx (вход через /admin/ после проверки админ-сессии).
# Отключить, если порт db-svc когда-либо будет опубликован наружу: тогда заголовок можно
# подделать, обратившись к контейнеру напрямую.
DBSVC_TRUST_GATEWAY_ROLE=true
